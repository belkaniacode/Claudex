msgid "Claudex"
msgstr "Claudex"

msgid "Proxy enabled"
msgstr "Прокси включён"

msgid "Off"
msgstr "Выключен"

msgid "Starting"
msgstr "Запускается"

msgid "Running locally"
msgstr "Работает локально"

msgid "Stopping"
msgstr "Останавливается"

msgid "Service failed - see details"
msgstr "Ошибка службы — откройте подробности"

msgid "External instance / port occupied"
msgstr "Внешний процесс / порт занят"

msgid "Service running; local readiness not verified"
msgstr "Служба запущена; готовность прокси не подтверждена"

msgid "Backend unavailable"
msgstr "Управление недоступно"

msgid "Unable to launch backend"
msgstr "Не удалось запустить модуль управления"

msgid "Invalid backend response"
msgstr "Некорректный ответ модуля управления"

msgid "Backend timed out; refresh status before retrying"
msgstr "Время ожидания истекло; обновите статус перед повтором"

msgid "Service: %1 | Local HTTP: %2"
msgstr "Служба: %1 | Локальный HTTP: %2"

msgid "Port occupied. Stop the terminal-launched proxy yourself before switching on."
msgstr "Порт занят. Перед включением самостоятельно остановите прокси, запущенный в терминале."

msgid "Account and quota are not checked. Stopping may interrupt active requests."
msgstr "Аккаунт и квота не проверяются. Остановка может прервать активные запросы."

msgid "Service action is taking longer than expected; refresh status."
msgstr "Операция службы длится дольше ожидаемого; обновите статус."

msgid "Details"
msgstr "Подробнее"

msgid "Hide details"
msgstr "Скрыть подробности"

msgid "Refresh"
msgstr "Обновить"

msgid "PID: %1 | Uptime: %2 s"
msgstr "PID: %1 | Время работы: %2 с"

msgid "Local probe: %1 ms | Ownership: %2"
msgstr "Локальная проверка: %1 мс | Процесс: %2"

msgid "Current service logs"
msgstr "Журнал текущего запуска"

msgid "Recent logs (may include previous runs)"
msgstr "Последние записи (включая прошлые запуски)"

msgid "No logs available"
msgstr "Журнал пока пуст"

msgid "Service logs"
msgstr "Журнал службы"

msgid "Output limit reached; showing a bounded excerpt."
msgstr "Достигнут лимит вывода; показана часть журнала."

msgid "Logs may contain sensitive data. Redaction is best-effort."
msgstr "Журнал может содержать личные данные. Автоматическое скрытие не гарантирует их полного удаления."

msgid "Claude profile: GPT proxy. Restart Claude Code to apply."
msgstr "Профиль Claude: GPT через прокси. Перезапустите Claude Code."

msgid "Claude profile needs recovery. Private backups are retained; switch off or inspect settings conflicts."
msgstr "Нужно восстановить профиль Claude. Защищённые копии сохранены; выключите переключатель или проверьте конфликт настроек."

msgid "Claude profile: original settings. Restart Claude Code after switching; VS Code may need Reload Window."
msgstr "Профиль Claude: исходные настройки. После переключения перезапустите Claude Code; в VS Code может понадобиться Reload Window."
